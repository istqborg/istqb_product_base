\cs_new_protected:Nn
  \__istqb_gset_with_spaces:Nn
  {
    \tl_gset:Nn
      #1
      { #2 }
    \regex_if_match:nnF
      { ^, }
      { #2 }
      {
        \tl_gput_left:Nn
          #1
          { ~ }
      }
    \tl_gput_right:Nn
      #1
      { ~ }
  }
\tl_new:N \g_istqb_list_delimiter_two_tl
\tl_new:N \g_istqb_list_delimiter_many_tl
\tl_new:N \g_istqb_list_delimiter_last_tl
