\tl_new:N
  \g_istqb_translation_list_of_tables_name_tl
\tl_new:N
  \g_istqb_translation_list_of_figures_name_tl
\keys_define:nn
  { istqb / language / lists }
  {
    table .tl_gset:N = \g_istqb_translation_list_of_tables_name_tl,
