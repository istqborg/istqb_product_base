\prop_new:N \l_istqb_markdown_table_spanned_rows_prop
\seq_new:N \l_istqb_markdown_table_attributes_seq
\regex_const:Nn
  \c_istqb_multi_row_and_multi_column_cell_regex
   {
     \c { markdownRendererAttributeKeyValue }
     \cB\{ ( rows | cols ) \cE\}
     \cB\{ ( [1-9][0-9]* ) \cE\}
   }
%%% Process a single cell of a table.
%%%
%%% Multi-column cells are typeset with `\multicolumn` and the cells that they span are skipped. Multi-row cells are
%%% marked as such in tagged PDF and we don't draw horizontal rules through them. The cells that they span should be
%%% empty.
\cs_new_protected:Nn
  \istqb_markdown_table_cell:n
  {
    \int_incr:N
      \l_istqb_markdown_table_column_int
    \int_compare:nNnTF
      { \l_istqb_markdown_table_skipped_cells_int } > { 0 }
      {
        \int_decr:N
          \l_istqb_markdown_table_skipped_cells_int
      }
      {
        % Determine the number of rows and columns that the cell spans.
        \int_set:Nn
          \l_istqb_markdown_table_cell_rows_int
          { 1 }
        \int_set:Nn
          \l_istqb_markdown_table_cell_columns_int
          { 1 }
        \regex_extract_all:NnNT
          \c_istqb_multi_row_and_multi_column_cell_regex
          { #1 }
          \l_istqb_markdown_table_attributes_seq
          {
            \int_step_inline:nnnn
              { 2 }
              { 3 }
              { \seq_count:N \l_istqb_markdown_table_attributes_seq }
              {
                \str_case:en
                  { \seq_item:Nn \l_istqb_markdown_table_attributes_seq { ##1 } }
                  {
                    { rows }
                    {
                      \int_set:Nn
                        \l_istqb_markdown_table_cell_rows_int
                        { \seq_item:Nn \l_istqb_markdown_table_attributes_seq { ##1 + 1 } }
                    }
                    { cols }
                    {
                      \int_set:Nn
                        \l_istqb_markdown_table_cell_columns_int
                        { \seq_item:Nn \l_istqb_markdown_table_attributes_seq { ##1 + 1 } }
                    }
                  }
              }
          }
        \int_set:Nn
          \l_istqb_markdown_table_cell_columns_int
          {
            \int_min:nn
              { \l_istqb_markdown_table_cell_columns_int }
              { \l_istqb_markdown_table_columns_int - \l_istqb_markdown_table_column_int + 1 }
          }
        % Typeset the cell.
        \int_compare:nNnF
          { \l_istqb_markdown_table_column_int } = { 1 }
          {
            \tl_put_right:Nn
              \l_istqb_markdown_table_row_tl
              { & }
          }
        \tl_set:Nn
          \l_istqb_markdown_table_cell_tl
          { #1 }
        \int_compare:nNnT
          { \l_istqb_markdown_table_cell_rows_int } > { 1 }
          {
            \tl_put_left:Nx
              \l_istqb_markdown_table_cell_tl
              {
                \exp_not:N \tagpdfsetup
                  { table / multirow = \int_use:N \l_istqb_markdown_table_cell_rows_int }
              }
            \int_set:Nn
              \l_istqb_markdown_table_spanned_rows_int
              { \l_istqb_markdown_table_cell_rows_int - 1 }
            \int_step_inline:nnn
              { \l_istqb_markdown_table_column_int }
              { \l_istqb_markdown_table_column_int + \l_istqb_markdown_table_cell_columns_int - 1 }
              {
                \prop_put:NnV
                  \l_istqb_markdown_table_spanned_rows_prop
                  { ##1 }
                  \l_istqb_markdown_table_spanned_rows_int
              }
          }
        \int_compare:nNnTF
          { \l_istqb_markdown_table_cell_columns_int } > { 1 }
          {
            \tl_put_right:Nx
              \l_istqb_markdown_table_row_tl
              {
                \exp_not:N \multicolumn
                  { \int_use:N \l_istqb_markdown_table_cell_columns_int }
                  {
                    \int_compare:nNnT
                      { \l_istqb_markdown_table_column_int } = { 1 }
                      { | }
                    c |
                  }
                  { \exp_not:V \l_istqb_markdown_table_cell_tl }
              }
            \int_set:Nn
              \l_istqb_markdown_table_skipped_cells_int
              { \l_istqb_markdown_table_cell_columns_int - 1 }
          }
          {
            \tl_put_right:NV
              \l_istqb_markdown_table_row_tl
              \l_istqb_markdown_table_cell_tl
          }
      }
  }
%%% Draw horizontal rules below a row of a table, except below the cells that span into the next row.
\cs_new_protected:Nn
  \istqb_markdown_table_rule:
  {
    \tl_clear:N
      \l_istqb_markdown_table_rule_tl
    \bool_set_false:N
      \l_istqb_markdown_table_spanned_bool
    \int_zero:N
      \l_istqb_markdown_table_rule_start_int
    \int_step_inline:nn
      { \l_istqb_markdown_table_columns_int + 1 }
      {
        \prop_get:NnNF
          \l_istqb_markdown_table_spanned_rows_prop
          { ##1 }
          \l_istqb_markdown_table_spanned_rows_tl
          {
            \tl_set:Nn
              \l_istqb_markdown_table_spanned_rows_tl
              { 0 }
          }
        \bool_lazy_or:nnTF
          { \int_compare_p:nNn { ##1 } > { \l_istqb_markdown_table_columns_int } }
          { \int_compare_p:nNn { \l_istqb_markdown_table_spanned_rows_tl } > { 0 } }
          {
            % There is no rule below this column (or we are past the last column). Draw the rule below the
            % preceding columns, if any.
            \int_compare:nNnF
              { ##1 } > { \l_istqb_markdown_table_columns_int }
              {
                \bool_set_true:N
                  \l_istqb_markdown_table_spanned_bool
              }
            \int_compare:nNnT
              { \l_istqb_markdown_table_rule_start_int } > { 0 }
              {
                \tl_put_right:Nx
                  \l_istqb_markdown_table_rule_tl
                  {
                    \exp_not:N \cline
                      {
                        \int_use:N \l_istqb_markdown_table_rule_start_int
                        -
                        \int_eval:n { ##1 - 1 }
                      }
                  }
                \int_zero:N
                  \l_istqb_markdown_table_rule_start_int
              }
          }
          {
            \int_compare:nNnT
              { \l_istqb_markdown_table_rule_start_int } = { 0 }
              {
                \int_set:Nn
                  \l_istqb_markdown_table_rule_start_int
                  { ##1 }
              }
          }
      }
    \bool_if:NTF
      \l_istqb_markdown_table_spanned_bool
      {
        \tl_put_right:NV
          \l_istqb_markdown_table_body_tl
          \l_istqb_markdown_table_rule_tl
      }
      {
        \tl_put_right:Nn
          \l_istqb_markdown_table_body_tl
          { \hline }
      }
    % Decrement the number of rows that are spanned by cells from the current row.
    \int_step_inline:nn
      { \l_istqb_markdown_table_columns_int }
      {
        \prop_get:NnNT
          \l_istqb_markdown_table_spanned_rows_prop
          { ##1 }
          \l_istqb_markdown_table_spanned_rows_tl
          {
            \int_compare:nNnTF
              { \l_istqb_markdown_table_spanned_rows_tl } > { 1 }
              {
                \int_set:Nn
                  \l_istqb_markdown_table_spanned_rows_int
                  { \l_istqb_markdown_table_spanned_rows_tl - 1 }
                \prop_put:NnV
                  \l_istqb_markdown_table_spanned_rows_prop
                  { ##1 }
                  \l_istqb_markdown_table_spanned_rows_int
              }
              {
                \prop_remove:Nn
                  \l_istqb_markdown_table_spanned_rows_prop
                  { ##1 }
              }
          }
      }
  }
\cs_generate_variant:Nn
  \istqb_table:nnnnn
  { VVVVV }
%%% Typeset the table.
\cs_new_protected:Nn
  \istqb_markdown_table_end:
  {
    \tl_clear:N
      \l_istqb_markdown_table_label_tl
    \tl_if_empty:NF
      \l_istqb_markdown_table_caption_tl
      {
        \tl_set_eq:NN
          \l_istqb_markdown_table_label_tl
          \l_istqb_table_identifier_tl
      }
    \istqb_table:VVVVV
      \l_istqb_markdown_table_caption_tl
      \l_istqb_markdown_table_label_tl
      \l_istqb_markdown_table_colspec_tl
      \l_istqb_markdown_table_header_tl
      \l_istqb_markdown_table_body_tl
    \bool_gset_false:N
      \g_istqb_intable_bool
  }
%%% Process a single row of a table.
\cs_new_protected:Nn
  \istqb_markdown_table_row:n
  {
    \int_incr:N
      \l_istqb_markdown_table_row_int
    \int_zero:N
      \l_istqb_markdown_table_column_int
    \int_zero:N
      \l_istqb_markdown_table_skipped_cells_int
    \tl_clear:N
      \l_istqb_markdown_table_row_tl
    \tl_map_function:nN
      { #1 }
      \istqb_markdown_table_cell:n
    \int_compare:nNnTF
      { \l_istqb_markdown_table_row_int } = { 1 }
      {
        % Record the header row. Cells in the header row may not span the following rows.
        \tl_set_eq:NN
          \l_istqb_markdown_table_header_tl
          \l_istqb_markdown_table_row_tl
        \prop_clear:N
          \l_istqb_markdown_table_spanned_rows_prop
      }
      {
        \tl_put_right:NV
          \l_istqb_markdown_table_body_tl
          \l_istqb_markdown_table_row_tl
        \tl_put_right:Nn
          \l_istqb_markdown_table_body_tl
          { \\ }
        \istqb_markdown_table_rule:
      }
    \int_compare:nNnTF
      { \l_istqb_markdown_table_row_int } < { \l_istqb_markdown_table_rows_int }
      { \istqb_markdown_table_row:n }
      { \istqb_markdown_table_end: }
  }
\cs_new_protected:Nn
  \istqb_markdown_table_alignments:n
  {
    \tl_if_empty:NTF
      \l_istqb_markdown_table_colspec_override_tl
      {
        \tl_set:Nn
          \l_istqb_markdown_table_colspec_tl
          { | }
        \tl_map_inline:nn
          { #1 }
          {
            \str_if_eq:nnTF
              { ##1 }
              { d }
              {
                \tl_put_right:Nn
                  \l_istqb_markdown_table_colspec_tl
                  { X | }
              }
              {
                \tl_put_right:Nn
                  \l_istqb_markdown_table_colspec_tl
                  { ##1 | }
              }
          }
      }
      {
        \tl_set_eq:NN
          \l_istqb_markdown_table_colspec_tl
          \l_istqb_markdown_table_colspec_override_tl
      }
    \int_compare:nNnTF
      { \l_istqb_markdown_table_rows_int } > { 0 }
      { \istqb_markdown_table_row:n }
      { \istqb_markdown_table_end: }
  }
%%% Start typesetting a table. The renderer `table` receives the caption (#1), the number of rows including the
%%% header row (#2), and the number of columns (#3). The renderer is followed by a row with the alignments of the
%%% columns and by the individual rows, which we process with `\istqb_markdown_table_alignments:n` and
%%% `\istqb_markdown_table_row:n`, respectively.
\cs_new_protected:Nn
  \istqb_markdown_table:nnn
  {
    \tl_set:Nn
      \l_istqb_markdown_table_caption_tl
      { #1 }
    \int_set:Nn
      \l_istqb_markdown_table_rows_int
      { #2 }
    \int_set:Nn
      \l_istqb_markdown_table_columns_int
      { #3 }
    \int_zero:N
      \l_istqb_markdown_table_row_int
    \tl_clear:N
      \l_istqb_markdown_table_header_tl
    \tl_clear:N
      \l_istqb_markdown_table_body_tl
    \prop_clear:N
      \l_istqb_markdown_table_spanned_rows_prop
    \istqb_markdown_table_alignments:n
  }
\markdownSetup
  {
    pipeTables,
    tableCaptions,
    tableAttributes,
    renderers = {
      tableAttributeContextBegin = {
        \group_begin:
        \markdownSetup
          {
            renderers = {
              attributeIdentifier = {
                \tl_set:Nx
                  \l_istqb_table_identifier_tl
                  {
                    \str_lowercase:n
                      { table:##1 }
                  }
              },
            },
          }
      },
      table = {
        \bool_gset_true:N
          \g_istqb_intable_bool
        \istqb_markdown_table:nnn
          { #1 }
          { #2 }
          { #3 }
      },
      tableAttributeContextEnd = {
        \group_end:
      },
    }
  }

