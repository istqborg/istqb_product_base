    1 .code:n = {
      \__istqb_gset_with_spaces:Nn
        \g_istqb_list_delimiter_two_tl
        { #1 }
    },
    2 .code:n = {
      \__istqb_gset_with_spaces:Nn
        \g_istqb_list_delimiter_many_tl
        { #1 }
    },
    3 .code:n = {
      \__istqb_gset_with_spaces:Nn
