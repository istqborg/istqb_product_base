\markdownSetupSnippet
  { traceability-matrix / number-of-related-learning-objectives }
  {
    renderers = {
      jekyllDataEnd += {
        \group_begin:
        % Construct the column specification: the numbers and the descriptions of business outcomes and learning
        % objectives, followed by one column per business outcome.
        \tl_set:Nn
          \l_istqb_traceability_matrix_colspec_tl
          { | l | X | }
        \tl_clear:N
          \l_istqb_traceability_matrix_empty_cells_tl
        \seq_map_inline:Nn
          \g_istqb_business_outcomes_numbers_seq
          {
            \tl_put_right:Nn
              \l_istqb_traceability_matrix_colspec_tl
              { c | }
            \tl_put_right:Nn
              \l_istqb_traceability_matrix_empty_cells_tl
              { & }
          }
        % Construct the header row, which is repeated on every page.
        \tl_set:Nn
          \l_istqb_traceability_matrix_header_tl
          {
            \hline
            \multicolumn
              { 1 }
