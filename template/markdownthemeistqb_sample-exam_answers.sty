\NeedsTeXFormat{LaTeX2e}
\ProvidesExplPackage
  {markdownthemeistqb_sample-exam_answers}%
  {2025-06-25}%
  {2.1.2}%
  {LaTeX theme for the Markdown Package that typesets ISTQB Sample Exam Answers documents}

% Import common code
\markdownSetup
  {
    import = {
      istqb/sample-exam = metadata,
    },
  }

% Metadata
\keys_define:nn
  { istqb/metadata }
  {
    type .code:n = {
      \tl_gset:Nn
        \g_istqb_type_tl
        {
          #1~--~
          \tl_use:N
            \g_istqb_translation_answer_plural_tl
        }
    },
  }

% Answer key
%% We typeset the answer key as pairs of tables side by side rather than as a single table in two columns with the
%% packages multicol and supertabular, since the package supertabular is incompatible with tagging.
%% See also <https://github.com/istqborg/istqb_product_base/issues/152#issuecomment-5715946481>.
\RequirePackage
  { array }
\newcolumntype
  { C }
  [ 1 ]
  { >{ \centering\arraybackslash } p { #1 } }
\tl_new:N
  \l_istqb_answer_key_header_tl
\tl_new:N
  \l_istqb_answer_key_row_tl
\tl_new:N
  \l_istqb_answer_key_table_tl
\seq_new:N
  \l_istqb_answer_key_rows_seq
\int_new:N
  \l_istqb_answer_key_rows_per_column_int
\int_new:N
  \l_istqb_answer_key_first_row_int
\int_new:N
  \l_istqb_answer_key_number_of_rows_int
\int_new:N
  \l_istqb_answer_key_number_of_left_rows_int
\cs_new_protected:Nn
  \istqb_print_answer_key:n
  {
    \group_begin:
    % Set the dimensions of the table rows.
    \int_compare:nTF
      { \seq_count:N \g_istqb_questions_seq > 45 }
      {
        \cs_set:Npn
          \arraystretch
          { 0.95 }
      }
      {
        \int_compare:nTF
        { \seq_count:N \g_istqb_questions_seq > 40 }
        {
          \cs_set:Npn
            \arraystretch
            { 1.025 }
        }
        {
          \cs_set:Npn
            \arraystretch
            { 1.175 }
        }
      }
    % In tagged PDF, mark the first row of each table as the header row.
    \tagpdfsetup
      { table / header-rows = { 1 } }
    % Prepare the header row of the tables.
    \tl_set:Nn
      \l_istqb_answer_key_header_tl
      {
        \hline
        \textbf
          {
            \tl_use:N
              \g_istqb_translation_question_number_tl
          } &
        \textbf
          {
            \tl_use:N
              \g_istqb_translation_correct_answer_tl
          } &
        \textbf
          {
            \tl_use:N
              \g_istqb_translation_learning_objective_tl
          } &
        \textbf
          {
            \tl_use:N
              \g_istqb_translation_k_level_tl
          } &
        \textbf
          {
            \tl_use:N
              \g_istqb_translation_number_of_points_tl
          } \\
        \hline
      }
    % Prepare the other rows of the tables.
    \seq_clear:N
      \l_istqb_answer_key_rows_seq
    \int_set:Nn
      \l_tmpa_int
      { 1 }
    \seq_map_inline:Nn
      \g_istqb_questions_seq
      {
        \prop_get:cnNF
          { g_istqb_question_additional_prop }
          { ##1 }
          \l_tmpa_tl
          {
            \tl_set:Nn
              \l_tmpa_tl
              { false }
          }
        \str_if_eq:VnT
          \l_tmpa_tl
          { #1 }
          {
            \tl_clear:N
              \l_istqb_answer_key_row_tl
            % Record the question number.
            \tl_put_right:Nn
              \l_istqb_answer_key_row_tl
              { \textbf }
            \tl_set:Nn
              \l_tmpa_tl
              { }
            \str_if_eq:nnT
              { #1 }
              { true }
              {
                \tl_put_right:Nn
                  \l_tmpa_tl
                  { A }
              }
            \tl_put_right:NV
              \l_tmpa_tl
              \l_tmpa_int
            \tl_put_right:Nx
              \l_istqb_answer_key_row_tl
              {
                {
                  \tl_use:N
                    \l_tmpa_tl
                } &
              }
            \int_incr:N
              \l_tmpa_int
            % Record the correct answers.
            \prop_if_in:cnTF
              { g_istqb_answer_correct
                _keys_prop }
              { ##1 }
              {
                \prop_get:cnN
                  { g_istqb_answer_correct
                    _keys_prop }
                  { ##1 }
                  \l_tmpa_clist
              }
              {
                \clist_clear:N
                  \l_tmpa_clist
              }
            \tl_put_right:Ne
              \l_istqb_answer_key_row_tl
              { \clist_use:Nn
                  \l_tmpa_clist
                  { ,~ } &
              }
            % Record the learning objective.
            \tl_put_right:NV
              \l_istqb_answer_key_row_tl
              \g_istqb_prefix_tl
            \tl_put_right:Nn
              \l_istqb_answer_key_row_tl
              { - }
            \prop_get:cnN
              { g_istqb_question_learning
                _objective_prop }
              { ##1 }
              \l_tmpa_tl
            \tl_put_right:NV
              \l_istqb_answer_key_row_tl
              \l_tmpa_tl
            \tl_put_right:Nn
              \l_istqb_answer_key_row_tl
              { & }
            % Record the K-level.
            \prop_get:NnN
              \g_istqb_question_k_level_prop
              { ##1 }
              \l_tmpa_tl
            \tl_put_right:NV
              \l_istqb_answer_key_row_tl
              \l_tmpa_tl
            \tl_put_right:Nn
              \l_istqb_answer_key_row_tl
              { & }
            % Record the number of points.
            \prop_get:cnN
              { g_istqb_question_number
                _of_points_prop }
              { ##1 }
              \l_tmpa_tl
            \tl_put_right:NV
              \l_istqb_answer_key_row_tl
              \l_tmpa_tl
            \tl_put_right:Nn
              \l_istqb_answer_key_row_tl
              { \\ \hline }
            \seq_put_right:NV
              \l_istqb_answer_key_rows_seq
              \l_istqb_answer_key_row_tl
          }
      }
    % Determine how many rows fit into a table on a single page, leaving space for a heading above the tables.
    \int_set:Nn
      \l_istqb_answer_key_rows_per_column_int
      {
        \int_max:nn
          { 1 }
          {
            \int_div_truncate:nn
              { \dim_to_decimal_in_sp:n { \textheight - 4 \baselineskip } }
              { \dim_to_decimal_in_sp:n { \arraystretch \baselineskip + \arrayrulewidth } }
            - 1
          }
      }
    % Typeset the rows in pairs of tables side by side, starting a new page for every pair of tables.
    \int_set:Nn
      \l_istqb_answer_key_first_row_int
      { 1 }
    \int_while_do:nNnn
      { \l_istqb_answer_key_first_row_int }
      <
      { \seq_count:N \l_istqb_answer_key_rows_seq + 1 }
      {
        \int_set:Nn
          \l_istqb_answer_key_number_of_rows_int
          {
            \int_min:nn
              { 2 * \l_istqb_answer_key_rows_per_column_int }
              {
                \seq_count:N \l_istqb_answer_key_rows_seq
                - \l_istqb_answer_key_first_row_int + 1
              }
          }
        \int_set:Nn
          \l_istqb_answer_key_number_of_left_rows_int
          {
            \int_div_truncate:nn
              { \l_istqb_answer_key_number_of_rows_int + 1 }
              { 2 }
          }
        \par
        \noindent
        \istqb_print_answer_key_table:nn
          { \l_istqb_answer_key_first_row_int }
          {
            \l_istqb_answer_key_first_row_int
            + \l_istqb_answer_key_number_of_left_rows_int - 1
          }
        \hspace
          { \columnsep }
        \istqb_print_answer_key_table:nn
          {
            \l_istqb_answer_key_first_row_int
            + \l_istqb_answer_key_number_of_left_rows_int
          }
          {
            \l_istqb_answer_key_first_row_int
            + \l_istqb_answer_key_number_of_rows_int - 1
          }
        \par
        \int_add:Nn
          \l_istqb_answer_key_first_row_int
          { \l_istqb_answer_key_number_of_rows_int }
      }
    \group_end:
  }
%%% Typeset a table with the rows #1 to #2 of the answer key in one half of the line.
\cs_new_protected:Nn
  \istqb_print_answer_key_table:nn
  {
    \int_compare:nNnF
      { #2 } < { #1 }
      {
        \tl_set:Nn
          \l_istqb_answer_key_table_tl
          {
            \begin
              { tabular }
              [ t ]
              { | C { 1.9cm } | C { 1.5cm }
                | C { 2.4cm } | C { 1.4cm }
                | C { 1.9cm } | }
          }
        \tl_put_right:NV
          \l_istqb_answer_key_table_tl
          \l_istqb_answer_key_header_tl
        \int_step_inline:nnn
          { #1 }
          { #2 }
          {
            \tl_put_right:Nx
              \l_istqb_answer_key_table_tl
              {
                \seq_item:Nn
                  \l_istqb_answer_key_rows_seq
                  { ##1 }
              }
          }
        \tl_put_right:Nn
          \l_istqb_answer_key_table_tl
          { \end { tabular } }
        \makebox
          [ \dim_eval:n { ( \linewidth - \columnsep ) / 2 } ]
          [ l ]
          {
            \tl_use:N
              \l_istqb_answer_key_table_tl
          }
      }
  }

% Answers
\RequirePackage
  { longtable }
\dim_const:Nn
  \c_explanation_width_dim
  { 11.15cm }
\tl_new:N
  \l_istqb_answers_table_tl
\cs_gset:Nn
  \__markdown_latex_fancy_list_item_label:nnn
  {
    \__markdown_latex_fancy_list_item_label_number:nn
      { #1 }
      { #3 }
    \str_if_eq:nnTF
      { #1 } { LowerAlpha }
      { ) }
      {
        \__markdown_latex_fancy_list_item_label_delimiter:n
          { #2 }
      }
  }
\cs_new_protected:Nn
  \istqb_print_answers:n
  {
    \group_begin:
    % Prepare the heading of the table.
    \cs_set:Npn
      \arraystretch
      { 1.5 }
    \tl_set:Nn
      \l_istqb_answers_table_tl
      {
        \begin
          { longtable }
          { | C { 1.9cm } | C { 1.5cm }
            | p
            { \c_explanation_width_dim }
            | C { 2.4cm } | C { 1.4cm }
            | C { 1.9cm } | }
        \hline
        \textbf
          {
            \tl_use:N
              \g_istqb_translation_question_number_tl
          } &
        \textbf
          {
            \tl_use:N
              \g_istqb_translation_correct_answer_tl
          } &
        \multicolumn
          { 1 }
          { C
            { \c_explanation_width_dim }
            | }
          {
            \textbf
              {
                \tl_use:N
                  \g_istqb_translation_explanation_tl
              }
          } &
        \textbf
          {
            \tl_use:N
              \g_istqb_translation_learning_objective_tl
          } &
        \textbf
          {
            \tl_use:N
              \g_istqb_translation_k_level_tl
          } &
        \textbf
          {
            \tl_use:N
              \g_istqb_translation_number_of_points_tl
          } \\
        \hline
        \endhead
      }
    % Prepare the lines of the table
    \int_set:Nn
      \l_tmpa_int
      { 1 }
    \seq_map_inline:Nn
      \g_istqb_questions_seq
      {
        \prop_get:cnNF
          { g_istqb_question_additional_prop }
          { ##1 }
          \l_tmpa_tl
          {
            \tl_set:Nn
              \l_tmpa_tl
              { false }
          }
        \str_if_eq:VnT
          \l_tmpa_tl
          { #1 }
          {
            % Record the question number.
            \tl_put_right:Nn
              \l_istqb_answers_table_tl
              { \textbf }
            \tl_set:Nn
              \l_tmpa_tl
              { }
            \str_if_eq:nnT
              { #1 }
              { true }
              {
                \tl_put_right:Nn
                  \l_tmpa_tl
                  { A }
              }
            \tl_put_right:NV
              \l_tmpa_tl
              \l_tmpa_int
            \tl_put_right:Nx
              \l_istqb_answers_table_tl
              {
                {
                  \tl_use:N
                    \l_tmpa_tl
                }
              }
            \tl_put_right:Nn
              \l_istqb_answers_table_tl
              {
                \phantomsection
                \addcontentsline
                  { toc }
                  { subsection }
              }
            \tl_set:NV
              \l_tmpa_tl
              \g_istqb_translation_question_singular_tl
            \tl_put_right:Nn
              \l_tmpa_tl
              { ~\# }
            \str_if_eq:nnT
              { #1 }
              { true }
              {
                \tl_put_right:Nn
                  \l_tmpa_tl
                  { A }
              }
            \tl_put_right:NV
              \l_tmpa_tl
              \l_tmpa_int
            \tl_put_right:Nx
              \l_istqb_answers_table_tl
              {
                {
                  \tl_use:N
                    \l_tmpa_tl
                } &
              }
            \int_incr:N
              \l_tmpa_int
            % Record the correct answers.
            \prop_if_in:cnTF
              { g_istqb_answer_correct
                _keys_prop }
              { ##1 }
              {
                \prop_get:cnN
                  { g_istqb_answer_correct
                    _keys_prop }
                  { ##1 }
                  \l_tmpa_clist
              }
              {
                \clist_clear:N
                  \l_tmpa_clist
              }
            \tl_put_right:Ne
              \l_istqb_answers_table_tl
              { \clist_use:Nn
                  \l_tmpa_clist
                  { ,~ } &
              }
            % Record the explanation / rationale.
            \tl_put_right:Nn
              \l_istqb_answers_table_tl
              { \begin
                  { minipage }
                  [ t ]
                  {
                    \c_explanation_width_dim
                  }
                \dim_set:Nn
                  \leftmargini
                  { 1.5em }
              }
            \prop_get:cnN
              { g_istqb_question_explanation
                _prop }
              { ##1 }
              \l_tmpa_tl
            \tl_put_right:NV
              \l_istqb_answers_table_tl
              \l_tmpa_tl
            \tl_put_right:Nn
              \l_istqb_answers_table_tl
              { \end { minipage }
                \medskip }
            \tl_put_right:Nn
              \l_istqb_answers_table_tl
              { & }
            % Record the learning objective.
            \tl_put_right:NV
              \l_istqb_answers_table_tl
              \g_istqb_prefix_tl
            \tl_put_right:Nn
              \l_istqb_answers_table_tl
              { - }
            \prop_get:cnN
              { g_istqb_question_learning
                _objective_prop }
              { ##1 }
              \l_tmpa_tl
            \tl_put_right:NV
              \l_istqb_answers_table_tl
              \l_tmpa_tl
            \tl_put_right:Nn
              \l_istqb_answers_table_tl
              { & }
            % Record the K-level.
            \prop_get:NnN
              \g_istqb_question_k_level_prop
              { ##1 }
              \l_tmpa_tl
            \tl_put_right:NV
              \l_istqb_answers_table_tl
              \l_tmpa_tl
            \tl_put_right:Nn
              \l_istqb_answers_table_tl
              { & }
            % Record the number of points.
            \prop_get:cnN
              { g_istqb_question_number_of
                _points_prop }
              { ##1 }
              \l_tmpa_tl
            \tl_put_right:NV
              \l_istqb_answers_table_tl
              \l_tmpa_tl
            \tl_put_right:Nn
              \l_istqb_answers_table_tl
              { \\ \hline }
          }
      }
    % Typeset the table.
    \tl_put_right:Nn
      \l_istqb_answers_table_tl
      { \end { longtable } }
    \tl_use:N
      \l_istqb_answers_table_tl
    \group_end:
  }
\cs_generate_variant:Nn
  \tl_put_right:Nn
  { Ne }

\markdownSetupSnippet
  { answer-key }
  {
    snippet = istqb / sample-exam
      / questions,
    fancyLists = true,
    renderers = {
      interblockSeparator = {
        \par
        \medskip
      },
      jekyllDataEnd = {
        \istqb_print_answer_key:n
          { false }
      },
    },
  }
\markdownSetupSnippet
  { answers }
  {
    snippet = istqb / sample-exam
      / questions,
    fancyLists = true,
    renderers = {
      interblockSeparator = {
        \par
        \medskip
      },
      jekyllDataEnd = {
        \istqb_print_answers:n
          { false }
      },
    },
  }
\markdownSetupSnippet
  { answers@v2 }
  {
    snippet = istqb / sample-exam
      / questions,
    fancyLists = true,
    renderers = {
      interblockSeparator = {
        \par
        \medskip
      },
      jekyllDataEnd = {
        \istqblandscapebegin
        \exp_args:NV
          \istqbunnumberedsection
          \g_istqb_translation_answer_key_tl
        \istqb_print_answer_key:n
          { false }
        \exp_args:NV
          \istqbunnumberedsection
          \g_istqb_translation_answer_plural_tl
        \istqb_print_answers:n
          { false }
        \prop_if_empty:NF
          \g_istqb_question_additional_prop
          {
            \begin{istqbappendices}
            \exp_args:NV
              \istqbunnumberedsection
              \g_istqb_translation_additional_answer_key_tl
            \istqb_print_answer_key:n
              { true }
            \exp_args:NV
              \istqbunnumberedsection
              \g_istqb_translation_additional_answer_plural_tl
            \istqb_print_answers:n
              { true }
            \end{istqbappendices}
          }
        \istqblandscapeend
      },
    },
  }
